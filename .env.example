PORT=7777
NODE_ENV=development

# Database URLs (Placeholders - supply strong credentials in production)
DATABASE_URL="postgresql://db_owner:<STRONG_OWNER_PASSWORD>@localhost:5432/trustvault"
APP_DATABASE_URL="postgresql://trustvault_app:<STRONG_APP_PASSWORD>@localhost:5432/trustvault"
TEST_DATABASE_URL="postgresql://trustvault_app:<STRONG_TEST_PASSWORD>@localhost:5432/trustvault_test"

# Cryptographic Master Secrets (Min 32-character random hex/base64 strings)
JWT_SECRET="<GENERATE_RANDOM_256BIT_SECRET_HEX>"
AUDIT_HMAC_SECRET="<GENERATE_RANDOM_256BIT_SECRET_HEX>"
STORAGE_ENCRYPTION_KEY="<GENERATE_RANDOM_256BIT_SECRET_HEX>"

# Storage Paths & External Cryptographic Audit Anchor
STORAGE_DIR="storage/uploads"
TEMP_DIR="storage/temp"
ANCHOR_FILE="storage/audit_anchor.json"

# Distributed Redis Cache (Port 6385 with requirepass)
REDIS_URL="redis://:<STRONG_REDIS_PASSWORD>@127.0.0.1:6385"
