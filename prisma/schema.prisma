generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String
  role         String               @default("VIEWER") // ADMIN, OWNER, VIEWER
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  ownedDocuments     Document[]           @relation("DocumentOwner")
  permissions        DocumentPermission[] @relation("GrantedPermissions")
  grantedByMe        DocumentPermission[] @relation("PermissionGranter")
  auditLogs          AuditLog[]           @relation("UserAudits")
}

model Document {
  id               String               @id @default(uuid())
  title            String
  description      String?
  originalFilename String
  storedFilename   String               @unique // Random UUID on disk
  fileSize         Int
  mimeType         String
  category         String               @default("General")
  fileHash         String               // SHA-256 checksum of file contents
  ownerId          String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  owner            User                 @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  permissions      DocumentPermission[]
  auditLogs        AuditLog[]
}

model DocumentPermission {
  id              String          @id @default(uuid())
  documentId      String
  userId          String
  permissionLevel String          @default("READ") // READ, EDIT
  grantedById     String
  grantedAt       DateTime        @default(now())

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User            @relation("GrantedPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User            @relation("PermissionGranter", fields: [grantedById], references: [id])

  @@unique([documentId, userId])
}

model AuditLog {
  id             String    @id @default(uuid())
  sequenceNumber Int       @unique
  timestamp      DateTime  @default(now())
  action         String    // UPLOAD, DOWNLOAD, VIEW, EDIT, DELETE, GRANT_PERMISSION, REVOKE_PERMISSION, ACCESS_DENIED, LOGIN
  userId         String?
  userEmail      String?
  documentId     String?
  documentTitle  String?
  status         String    // SUCCESS, DENIED, FAILED
  ipAddress      String?
  userAgent      String?
  details        String?
  previousHash   String
  hash           String

  user           User?     @relation("UserAudits", fields: [userId], references: [id], onDelete: SetNull)
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}
